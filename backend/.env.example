# ============================================================
# EVENTHUB BACKEND — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ── Server ─────────────────────────────────────────────────
PORT=5000
# Public URL of the frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────
MONGO_URI=your_mongodb_connection_string

# ── Auth / Security ────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# ── Google OAuth (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://teameklavya.onrender.com/api/auth/google/callback

# ── Cloudinary (image uploads — replaces ImgBB) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: Resend (PRIMARY) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_NAME=EventHub
EMAIL_FROM_ADDRESS=eventhub-noreply@ayanm.in

# ── Email: Gmail SMTP (FALLBACK) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Email branding ─────────────────────────────────────────
# Cloudinary-hosted logo URL used inside email templates
EMAIL_LOGO_URL=

# ── Part 5: Performance & infrastructure (all optional, safe defaults) ──
# Structured access-log verbosity: error | warn | info (default) | debug
LOG_LEVEL=info
# Max entries in the in-memory cache (public event/org/explore data)
CACHE_MAX_ENTRIES=500
# Set to 1 to bypass the cache entirely (debugging only)
# CACHE_DISABLED=1
# MongoDB connection pool ceiling (free tier: keep small)
MONGO_MAX_POOL_SIZE=10

# ── Part 5, Phase 8: data retention (§53/§54) ───────────────
# Live chat (LiveMessage) and Q&A (QAQuestion) archival window, in days.
# UNSET or 0 MEANS KEEP FOREVER — archival is opt-in, never a surprise.
# EventResult snapshots and certificates do NOT depend on these collections,
# so enabling this can never invalidate a certificate.
# RETENTION_LIVE_ARCHIVE_DAYS=180

# ── Part 6, Phase 1: Redis / distributed cache (§1, §3) ─────
# Which cache provider to use. "memory" (default) is a per-process LRU and
# needs no configuration — it is what you want for local dev and for any
# single-instance deployment. "upstash" shares the cache across instances.
# Every variable here is OPTIONAL: the app boots and serves correctly with
# Redis entirely absent, and degrades to the in-memory provider if Redis
# becomes unreachable at runtime.
CACHE_PROVIDER=memory

# Only read when CACHE_PROVIDER=upstash. Upstash REST credentials — server-side
# ONLY. Never expose these to the frontend, and never commit real values.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Key namespace and schema version. Every key is "<ns>:<version>:cache:<domain>:<id>".
# Bumping the VERSION invalidates the ENTIRE cache at once — that is the
# supported way to migrate a key shape, so old entries simply expire unused.
# CACHE_KEY_NAMESPACE=eh
# CACHE_KEY_VERSION=v1

# Rate limiting (Part 6, Phase 2 — §4). "memory" keeps today's per-process
# behaviour; "upstash" makes every instance count into the SAME bucket, so a
# client that hits Server A five times and Server B five times has made ten
# requests, not two lots of five. Limits FAIL OPEN: if Redis is unreachable
# traffic is allowed and the outage is counted, because a rate-limiter outage
# that blocks all traffic is a self-inflicted outage.
# RATE_LIMIT_PROVIDER=memory

# Circuit breaker: after this many consecutive Redis failures the provider
# stops calling Redis and serves from memory until the cooldown elapses.
# CACHE_FAILURE_THRESHOLD=3
# CACHE_COOLDOWN_MS=30000

# Idempotency (Part 6, Phase 3 — §5). Unset defaults to CACHE_PROVIDER.
# With "upstash", an Idempotency-Key claimed on one instance is honoured by
# every other instance, so a retried registration, ticket issuance or quiz
# submission cannot create a duplicate. The claim is a single atomic
# "SET key NX PX ttl" — there is no read-then-write window, so two instances
# racing for the same key cannot both win.
# On a Redis outage this degrades to per-instance dedup rather than allowing
# everything through: the cost of a failed claim is a duplicate registration
# or a double payment, which is not an acceptable failure mode.
# IDEMPOTENCY_PROVIDER=memory

# ── Part 5, Phase 7: infrastructure budgets (§59) ───────────
# Budgets the admin infrastructure dashboard scores against. Set these to
# whatever your deployment actually has; they only affect severity levels.
# MongoDB Atlas free tier is 512 MB.
INFRA_BUDGET_MONGO_MB=512
# Cache entry ceiling (keep in step with CACHE_MAX_ENTRIES)
INFRA_BUDGET_CACHE_ENTRIES=500
# Upstash free tier: 500K commands/month
INFRA_BUDGET_CACHE_COMMANDS=500000
# Soft ceiling for concurrent sockets on one instance
INFRA_BUDGET_SOCKETS=2000
# p95 latency target in ms — above this the API section escalates
INFRA_TARGET_API_P95_MS=800
# Node heap budget
INFRA_BUDGET_HEAP_MB=512

# ── Part 5, Phase 6: realtime caps (§43) ────────────────────
# CONCURRENCY ceilings — how many sockets may exist AT ONCE. These are a
# different axis from the Phase 2 rate windows, which bound how OFTEN a
# client may connect. A client reconnecting every 8s never trips a per-minute
# rate window yet still accumulates sockets forever, and every socket costs
# memory and event-loop time on one small instance.
#
# Tabs/devices one signed-in user may hold open simultaneously.
REALTIME_CAP_SOCKETS_PER_USER=5
# Sockets from one IP at once. Higher than per-user because a classroom,
# office or carrier NAT legitimately shares an address.
REALTIME_CAP_SOCKETS_PER_IP=20
# Distinct participants allowed in one event room.
REALTIME_CAP_PARTICIPANTS_PER_ROOM=500
# A room with no sockets is reaped once idle this long (ms).
REALTIME_CAP_IDLE_ROOM_TTL_MS=1800000
# How often the stale-socket sweep runs (ms).
REALTIME_CAP_SWEEP_INTERVAL_MS=300000

# ── Part 5, Phase 4: media / storage ───────────────────────
# Cloudinary (above) is the image provider. Without credentials the app
# transparently falls back to local disk so local dev still works.
#
# Orphan reclamation (§55): if an upload succeeds but the write that consumes
# it fails, the asset is marked `cleanup_pending` and reclaimed after a 24h
# grace window. Run it from cron / a scheduled job:
#
#   npm run media:sweep          # dry run — reports only, deletes nothing
#   npm run media:sweep:apply    # actually reclaim
#
# `active` assets (anything referenced by an event, post or user) are NEVER
# reclaimed — only unattached uploads past their grace window.
