# ============================================================
# EVENTHUB BACKEND — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ── Server ─────────────────────────────────────────────────
PORT=5000
# Public URL of the frontend (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────
MONGO_URI=your_mongodb_connection_string

# ── Auth / Security ────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# ── Google OAuth (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://teameklavya.onrender.com/api/auth/google/callback

# ── Cloudinary (image uploads — replaces ImgBB) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: Resend (PRIMARY) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_NAME=EventHub
EMAIL_FROM_ADDRESS=eventhub-noreply@ayanm.in

# ── Email: Gmail SMTP (FALLBACK) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Email branding ─────────────────────────────────────────
# Cloudinary-hosted logo URL used inside email templates
EMAIL_LOGO_URL=

# ── Part 5: Performance & infrastructure (all optional, safe defaults) ──
# Structured access-log verbosity: error | warn | info (default) | debug
LOG_LEVEL=info
# Max entries in the in-memory cache (public event/org/explore data)
CACHE_MAX_ENTRIES=500
# Set to 1 to bypass the cache entirely (debugging only)
# CACHE_DISABLED=1
# MongoDB connection pool ceiling (free tier: keep small)
MONGO_MAX_POOL_SIZE=10

# ── Part 5, Phase 6: realtime caps (§43) ────────────────────
# CONCURRENCY ceilings — how many sockets may exist AT ONCE. These are a
# different axis from the Phase 2 rate windows, which bound how OFTEN a
# client may connect. A client reconnecting every 8s never trips a per-minute
# rate window yet still accumulates sockets forever, and every socket costs
# memory and event-loop time on one small instance.
#
# Tabs/devices one signed-in user may hold open simultaneously.
REALTIME_CAP_SOCKETS_PER_USER=5
# Sockets from one IP at once. Higher than per-user because a classroom,
# office or carrier NAT legitimately shares an address.
REALTIME_CAP_SOCKETS_PER_IP=20
# Distinct participants allowed in one event room.
REALTIME_CAP_PARTICIPANTS_PER_ROOM=500
# A room with no sockets is reaped once idle this long (ms).
REALTIME_CAP_IDLE_ROOM_TTL_MS=1800000
# How often the stale-socket sweep runs (ms).
REALTIME_CAP_SWEEP_INTERVAL_MS=300000

# ── Part 5, Phase 4: media / storage ───────────────────────
# Cloudinary (above) is the image provider. Without credentials the app
# transparently falls back to local disk so local dev still works.
#
# Orphan reclamation (§55): if an upload succeeds but the write that consumes
# it fails, the asset is marked `cleanup_pending` and reclaimed after a 24h
# grace window. Run it from cron / a scheduled job:
#
#   npm run media:sweep          # dry run — reports only, deletes nothing
#   npm run media:sweep:apply    # actually reclaim
#
# `active` assets (anything referenced by an event, post or user) are NEVER
# reclaimed — only unattached uploads past their grace window.
