# ============================================================
# EVENTHUB FRONTEND — Vercel Environment Configuration
# ============================================================
# Vercel: Project → Settings → Environment Variables
#
# IMPORTANT — these are NEXT_PUBLIC_ variables, which means they are
# BAKED INTO THE BROWSER BUNDLE at build time. Two consequences:
#
#   1. NEVER put a secret here. No service-role keys, no API secrets.
#      Anything in this file is readable by anyone who opens devtools.
#   2. Changing one requires a REDEPLOY. Editing the variable in Vercel and
#      expecting the live site to change will not work — trigger a redeploy.
#
# Also: set these for BOTH Production and Preview if you use preview builds.
# ============================================================

# ── Backend API URL ────────────────────────────────────────────
# [REQUIRED] Your Render backend URL. NO trailing slash, NO /api suffix.
#   https://your-api.onrender.com
#
# This is the single most common deployment mistake. If it is wrong or has a
# trailing slash, you get CORS errors and 404s that look like backend outages.
# The code falls back to https://teameklavya.onrender.com if unset — do not
# rely on that in production.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# ── Public site URL ────────────────────────────────────────────
# [REQUIRED] Used for canonical URLs, Open Graph tags and SEO metadata.
# If this points at localhost in production, your shared links and SEO are wrong.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Google Maps (optional) ─────────────────────────────────────
# Only needed for map embeds on event pages. This key is exposed in the
# browser by design — restrict it in Google Cloud Console by HTTP referrer
# (your Vercel domain) so it cannot be used from elsewhere.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
