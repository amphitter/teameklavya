# ============================================================
# EVENTHUB BACKEND — Production Environment Configuration
# ============================================================
# Copy to .env for local work. On Render, paste these into
# Dashboard → Environment (NOT as a file — .env must never be committed).
#
# LEGEND
#   [REQUIRED]  the app will not boot, or a core feature will silently fail
#   [PROD]      required in production, optional in local dev
#   [OPTIONAL]  has a safe default
#
# NEVER commit a real .env. `npm run scan-secrets` will fail if you do.
# ============================================================

# ── Server ────────────────────────────────────────────────────
# Render injects PORT automatically. Do not hard-code it there.
PORT=5000
# [REQUIRED] Must be "production" on Render — controls cookie Secure flags,
# error verbosity, and helmet behaviour.
NODE_ENV=production
# [REQUIRED] Your Vercel URL. NO trailing slash. This is the CORS allowlist —
# if it is wrong, the browser blocks every API call and you will see CORS
# errors that look like backend outages.
FRONTEND_URL=https://your-app.vercel.app

# ── Database (MongoDB Atlas — event core, source of truth) ─────
# [REQUIRED] server.js exits FATAL without this. NOTE: the variable is
# MONGO_URI. MONGODB_URI is accepted by some tooling but is NOT the one
# checked at boot — set MONGO_URI.
# Atlas: Clusters → Connect → Drivers. Whitelist Render's IPs, or use
# 0.0.0.0/0 if Render's egress IPs are not static.
MONGO_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/eventhub?retryWrites=true&w=majority
# Connection pool. Render's free/starter instances are small — keep this low.
MONGO_MAX_POOL_SIZE=10

# ── Auth ──────────────────────────────────────────────────────
# [REQUIRED] Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every session. Never reuse a dev secret in prod.
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=10

# [PROD] Permanent Super Admin. This account is undeletable, undemotable and
# untransferable by design (Part 7 §10). Set it once — changing it later does
# NOT demote the previous holder.
SUPER_ADMIN_EMAIL=devanshsinghr00@gmail.com

# ── Google OAuth (optional but expected in prod) ───────────────
# Google Cloud Console → Credentials → Authorised redirect URI must EXACTLY
# match GOOGLE_CALLBACK_URL, or Google returns redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/auth/google/callback

# ── Redis (Upstash — shared ephemeral state) ───────────────────
# [PROD] Required the moment you run more than one instance. With the
# in-memory fallback, each instance keeps its OWN cache, locks, idempotency
# keys and rate-limit counters — so two instances silently double your real
# rate limit and can double-process an idempotent write.
#
# Set the credentials, then opt in per subsystem (see below).
UPSTASH_REDIS_REST_URL=https://apn1-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Master switch for cache / distributed locks / idempotency:
#   memory  → per-instance (fine for ONE instance)
#   upstash → shared across instances (REQUIRED for 2+)
CACHE_PROVIDER=upstash
# Rate limiting has its own switch and defaults to memory:
#   RATE_LIMIT_PROVIDER=memory   → per-instance
#   RATE_LIMIT_PROVIDER=upstash  → shared across instances
RATE_LIMIT_PROVIDER=upstash
# Locks and idempotency fall back to CACHE_PROVIDER unless set explicitly.
# LOCK_PROVIDER=upstash
# IDEMPOTENCY_PROVIDER=upstash

# ── Supabase (relational / social target) ──────────────────────
# [OPTIONAL] The event engine runs without Supabase — a Supabase outage must
# never break events (Part 7 §12). Leave blank to disable sync entirely.
# Use the SERVICE ROLE key server-side only. It bypasses RLS.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Master switch for the Mongo → Supabase outbox sync.
SYNC_ENABLED=false
SUPABASE_TIMEOUT_MS=5000
SUPABASE_MAX_ROWS=1000
SUPABASE_NPLUSONE_THRESHOLD=20

# ── Cloudinary (image uploads) ─────────────────────────────────
# [PROD] Without these, uploads fall back to LOCAL DISK — which on Render is
# ephemeral and wiped on every deploy. Images would vanish.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: Resend (primary) ────────────────────────────────────
# [PROD] Needed for verification emails and password reset.
RESEND_API_KEY=
EMAIL_FROM_NAME=EventHub
# Must be a domain you have verified in Resend, or sends are rejected.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Email: SMTP fallback ───────────────────────────────────────
# Used when Resend is not configured. Gmail needs an App Password, not your
# account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email branding (Cloudinary-hosted logo rendered in templates)
EMAIL_LOGO_URL=

# ── Observability ──────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
# Per-endpoint latency target used by the perf guard (§25)
INFRA_TARGET_API_P95_MS=600
# Monthly infrastructure budgets that trigger warnings (Upstash free tier is
# 500K commands/month — the default below leaves headroom)
INFRA_BUDGET_CACHE_COMMANDS=400000
INFRA_BUDGET_MONGO_MB=450
INFRA_BUDGET_HEAP_MB=400
INFRA_BUDGET_SOCKETS=500
INFRA_BUDGET_CACHE_ENTRIES=500

# ── Cache tuning ───────────────────────────────────────────────
CACHE_MAX_ENTRIES=500
# Namespace + version let you flush the whole cache by bumping a number
# instead of deleting keys. Bump CACHE_KEY_VERSION to invalidate everything.
CACHE_KEY_NAMESPACE=eventhub
CACHE_KEY_VERSION=1
# After repeated Redis failures, stop calling it for this long (ms)
CACHE_COOLDOWN_MS=30000
CACHE_FAILURE_THRESHOLD=3

# ── Realtime (Socket.IO) caps ──────────────────────────────────
REALTIME_CAP_SOCKETS_PER_IP=50
REALTIME_CAP_SOCKETS_PER_USER=5
REALTIME_CAP_PARTICIPANTS_PER_ROOM=500
REALTIME_CAP_IDLE_ROOM_TTL_MS=1800000
REALTIME_CAP_SWEEP_INTERVAL_MS=300000

# ── Background jobs ────────────────────────────────────────────
OUTBOX_LEASE_MS=30000
REMINDER_INTERVAL_MIN=15
# Set to 1 to stop the in-process reminder scheduler (useful if you scale to
# multiple instances and want ONE designated worker)
DISABLE_REMINDER_SCHEDULER=0

# ── Data retention ─────────────────────────────────────────────
# OPTIONAL, and commented out on purpose: retention is OPT-IN.
#
# LEFT UNSET MEANS KEEP FOREVER. Nothing is deleted unless you explicitly
# enable this. A retention window is a data-deletion switch — it must never
# become active just because someone copy-pasted an example file. Uncomment
# only once you have decided to archive live activity data.
#
# RETENTION_LIVE_ARCHIVE_DAYS=30

# ── Flags you should leave ALONE in production ─────────────────
# Each of these disables a protection. They exist for local load testing only.
# RATE_LIMIT_DISABLED=1     → removes all rate limiting. NEVER in prod.
# CACHE_DISABLED=1          → disables caching
# DEMO_MODE=1               → demo fixtures, which must never mix with real data
# UPLOADS_DIR=              → local upload path; use Cloudinary instead
